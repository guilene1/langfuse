# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Langfuse, for tracing and evaluation. Leave these empty and the app runs exactly as before.
# Create the keys in the Langfuse web interface: docs/langfuse-lab/01-langfuse-setup.md
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# From inside the app container, "localhost" is the container itself, so Langfuse is reached
# through Docker Desktop's name for your computer instead
LANGFUSE_BASE_URL=http://host.docker.internal:3000
