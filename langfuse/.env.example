# Settings for the local Langfuse stack in this folder.
#
# Do not copy this file by hand. Run the generator, which fills every secret with a random value:
#
#   .\New-LangfuseEnv.ps1
#
# It writes langfuse\.env, which Git ignores. This file only shows what that one contains.

# The Langfuse release every student runs
LANGFUSE_VERSION=4.56.0

# Where the web interface is opened. Login links and redirects are built from it.
NEXTAUTH_URL=http://localhost:3000

# Do not send anonymous usage statistics to Langfuse
TELEMETRY_ENABLED=false

# Sessions, hashing and encryption of stored secrets (such as LLM keys added in the UI)
NEXTAUTH_SECRET=<generated>
SALT=<generated>
# Exactly 64 hex characters
ENCRYPTION_KEY=<generated>

# Langfuse's own Postgres, inside the Docker network only. Not the Northwind database.
POSTGRES_PASSWORD=<generated>
DATABASE_URL=postgresql://postgres:<same as POSTGRES_PASSWORD>@postgres:5432/postgres

CLICKHOUSE_PASSWORD=<generated>
REDIS_AUTH=<generated>

# MinIO stores raw events and media. The three S3 keys must equal MINIO_ROOT_PASSWORD.
MINIO_ROOT_PASSWORD=<generated>
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=<same as MINIO_ROOT_PASSWORD>
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=<same as MINIO_ROOT_PASSWORD>
LANGFUSE_S3_BATCH_EXPORT_SECRET_ACCESS_KEY=<same as MINIO_ROOT_PASSWORD>
